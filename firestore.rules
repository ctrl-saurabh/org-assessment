rules_version = '2';

// Who can read and write the assessment data.
//
// There is no sign-in. The shared link carries an access code (…/org-assessment/?k=CODE),
// and all data lives under spaces/<CODE>/. Only requests that know the code get in.
//
// THIS FILE IS PUBLIC, so it holds a placeholder. Do not commit the real code.
// Paste this into Firebase console → Firestore Database → Rules, replace
// REPLACE_WITH_ACCESS_CODE with your code, then click Publish.
// To cut everyone off (e.g. a link leaked), publish a new code and share the new link.
// The data stays under the old code, so export it first and import it after switching.
service cloud.firestore {
  match /databases/{database}/documents {

    match /spaces/{code}/{collection}/{id} {
      allow read, write: if code == 'REPLACE_WITH_ACCESS_CODE'
                         && collection in ['clients', 'team', 'answers', 'comments'];
    }

    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
